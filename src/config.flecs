//System_ChangePawnToWoodcutter{ Disabled }
Pawn_FakeAttack{ Disabled }


// Buildings
// First define the prefabs
prefab Buildings.Building_Prefab {}
prefab Buildings.Granary_Prefab: Buildings.Building_Prefab {
    Buildings.components.BuildingUI: {3, -3, -1, 0}
    Buildings.components.Resources: {0, 0, 0}
}
// Add buildings
Buildings.components.buildingsParent {
    Granary1: Buildings.Granary_Prefab {
        Coordinates.components.Grid: {3, 8}
        Coordinates.components.Cell: {x: 0, y: 0}
    }
    Granary2: Buildings.Granary_Prefab {
        Coordinates.components.Grid: {5, 10}
        Coordinates.components.Cell: {x: 0, y: 0}
    }
}

// Gaia
prefab Map.Tree_Prefab {
    //Buildings.NatureType  // TODO: Put this back in if it has a purpose
}

// Pawns
Pawn.pawnsParent {
    for x in 0 .. 1 {
        "Pawn_$x": Pawn.Pawn_Prefab {
            Pawn.components.IsAPawn
            Coordinates.components.Grid: {x: 5*x, y: 25-2*x}
            Coordinates.components.Cell: {x: 0, y: 0}
            Coordinates.components.CellVelocity: {x: 0, y: 0}
            Coordinates.components.GridBase
            Pawn.components.PawnAbilityTraits: {strength: 0, speed: 300.0, woodcut_speed: 40.0}
            (Statemachine.components.CurveFile, Pawn.components.Alive): {filename: "../../state1.csv"}
            Buildings.components.Resources: {0, 0, 0}
            Buildings.components.ResourcesLimits: {wood: 50, stone: 50, fish: 50}
        }
    }
   
}


$ {
    Buildings.components.Resources: {0, 0, 0}
}